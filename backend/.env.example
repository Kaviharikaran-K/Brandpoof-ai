ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL via docker compose
DATABASE_URL=postgresql+asyncpg://brandproof:brandproof@localhost:5432/brandproof
# No-Docker fallback:
# DATABASE_URL=sqlite+aiosqlite:///./brandproof.db

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set true when serving over HTTPS (production forces this automatically)
COOKIE_SECURE=false

# Optional: external tone/language provider. Leaving this empty keeps every
# check deterministic and local. Sending copy externally also requires an
# admin to enable consent on the brand profile page.
BRANDPROOF_LLM_API_KEY=
# OPENAI_API_KEY=
